# SQLite (default). DB file: backend-flask/instance/recipe_app.db
# Leave DATABASE_URL unset to use the default instance path, or set explicitly:
# DATABASE_URL=sqlite:///C:/path/to/backend-flask/instance/recipe_app.db

FLASK_PORT=5002

# Local Ollama (Qwen) for AI recipe generation
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
